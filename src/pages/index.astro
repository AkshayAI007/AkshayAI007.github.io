---
import Credentials from '@/components/home/Credentials.astro';
import FinalCta from '@/components/home/FinalCta.astro';
import Hero from '@/components/home/Hero.astro';
import Impact from '@/components/home/Impact.astro';
import Manifesto from '@/components/home/Manifesto.astro';
import Method from '@/components/home/Method.astro';
import Projects from '@/components/home/Projects.astro';
import SiteFooter from '@/components/home/SiteFooter.astro';
import Stack from '@/components/home/Stack.astro';
import Systems from '@/components/home/Systems.astro';
import WritingPreview from '@/components/home/WritingPreview.astro';
import LegacyHashRedirect from '@/components/LegacyHashRedirect.astro';
import Page from '@/layouts/Page.astro';
import { buildSeo, personJsonLd } from '@/lib/seo';
import { SITE } from '@/lib/site';

const site = Astro.site!;
const seo = buildSeo(
  {
    title: `${SITE.name} — ${SITE.role}`,
    description:
      'Senior Generative AI & LLM engineer. I design, ship and evaluate production AI systems: multi-agent orchestration, RAG at 3M+ SMB scale, voice AI on LiveKit and Twilio, and LLM-as-Judge evaluation.',
    socialDescription:
      'Production AI systems, with the numbers: a 2-day service queue cut to 3 minutes, an agent serving 3M+ SMBs in under 3 seconds, and 20+ LLM systems shipped.',
    path: '/',
    ogImage: '/og/home.png',
    ogType: 'profile',
  },
  site,
);
const jsonLd = [
  personJsonLd(site),
  { '@type': 'WebSite', '@id': new URL('/#website', site).href, url: site.href, name: SITE.name, publisher: { '@id': new URL('/#person', site).href } },
];
---

<Page seo={seo} current="home" pageId="home" jsonLd={jsonLd}>
  <LegacyHashRedirect slot="head" />
  <main id="top">
    <div class="progress-line" id="progressLine" style="transform:scaleX(0)"></div>

    <Hero />
    <Impact />
    <Stack />
    <Manifesto />
    <Systems />
    <Method />
    <Projects />
    <WritingPreview />
    <Credentials />
    <FinalCta />
    <SiteFooter />
    <button class="floating-ask" id="floatingAskBtn" data-ask-open aria-label="Ask Akshay's portfolio"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg><span>ASK AKSHAY</span></button>
  </main>
</Page>
