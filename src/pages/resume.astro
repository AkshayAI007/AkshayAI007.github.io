<script>
  import { SITE } from '@/lib/site';

  // Fetch the PDF and hand the browser a blob with an explicit file name:
  // that forces a save across Chrome/Firefox/Edge/Safari instead of opening
  // the built-in viewer. If fetch fails, fall back to a plain download link.
  const btn = document.getElementById('downloadResumeBtn') as HTMLButtonElement;
  const note = document.getElementById('downloadResumeNote')!;
  const FILE = 'Akshay_Bawaliwale_Resume.pdf';

  const clickLink = (href: string, extra: Partial<HTMLAnchorElement> = {}) => {
    const a = Object.assign(document.createElement('a'), { href, download: FILE, ...extra });
    document.body.appendChild(a);
    a.click();
    a.remove();
  };

  btn.addEventListener('click', async () => {
    btn.disabled = true;
    note.textContent = 'Preparing file…';
    try {
      const res = await fetch(SITE.resumePdf, { cache: 'no-store' });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const url = URL.createObjectURL(await res.blob());
      clickLink(url);
      setTimeout(() => URL.revokeObjectURL(url), 4000);
      note.textContent = 'Saved to your device.';
    } catch {
      clickLink(SITE.resumePdf, { target: '_blank', rel: 'noopener' });
      note.textContent = "If the download didn't start, use your browser's save option on the opened PDF.";
    } finally {
      btn.disabled = false;
      setTimeout(() => { note.textContent = ''; }, 7000);
    }
  });
</script>
