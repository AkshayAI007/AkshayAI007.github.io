---
import Page from '@/layouts/Page.astro';
import { breadcrumbJsonLd, buildSeo, personJsonLd } from '@/lib/seo';
import { SITE } from '@/lib/site';

const seo = buildSeo(
  {
    title: 'Resume | Akshay Bawaliwale',
    description:
      'The one-page version: 20+ production LLM systems, the measured outcomes, the skills by layer and the experience behind them. Download the PDF.',
    path: '/resume',
    ogImage: '/og/resume.png',
  },
  Astro.site!,
);
const site = Astro.site!;
const jsonLd = [
  {
    '@type': 'ProfilePage',
    url: seo.canonical,
    name: seo.title,
    mainEntity: { '@id': new URL('/#person', site).href },
    associatedMedia: { '@type': 'MediaObject', contentUrl: new URL(SITE.resumePdf, site).href, encodingFormat: 'application/pdf' },
  },
  personJsonLd(site),
  breadcrumbJsonLd(site, [{ name: 'Home', path: '/' }, { name: 'Resume', path: '/resume' }]),
];
---

<Page seo={seo} current="resume" pageId="resume" jsonLd={jsonLd}>
  <main id="top" class="index-page resume-page">
    <section class="index-hero section-shell reveal">
