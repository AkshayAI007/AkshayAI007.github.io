---
/** Closing call to action over the graded night-Earth photograph. */
import earth from '@/assets/images/photos/earth-at-night.jpg';
import Photo from '@/components/Photo.astro';
---

<section class="final-cta reveal">
  <figure class="shot" aria-hidden="true"><Photo src={earth} alt="Earth at night from orbit, city lights tracing the coastlines" sizes="100vw" /></figure>
  <p>HAVE AN AI PROBLEM THAT REFUSES TO BEHAVE?</p>
  <h2>Let's architect it.</h2>
  <a href="/reach" class="button button-light">START A CONVERSATION →</a>
</section>
