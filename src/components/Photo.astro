---
/**
 * Self-hosted photograph: AVIF + WebP at the widths v1 requested from the
 * Unsplash CDN (640 / 960 / 1400 / 1920), capped at the source width.
 * Grading (grayscale, sepia, scrim) stays in CSS, as in v1 — see `.shot`.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  eager?: boolean;
  /** Encoder quality; lower it for photos the design shows dimmed. */
  quality?: number;
}

const { src, alt, sizes, eager = false, quality = 70 } = Astro.props;
const widths = [640, 960, 1400, 1920].filter((w) => w <= src.width);
if (!widths.includes(src.width) && src.width < 1920) widths.push(src.width);
---

<Picture
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes}
  formats={['avif', 'webp']}
  quality={quality}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
/>
